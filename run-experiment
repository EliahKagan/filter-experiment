#!/bin/sh
set -e

# Create the remote repository.
git init -q remote-repo
echo '* filter=arrow-example' >remote-repo/.gitattributes
git -C remote-repo add .
git -C remote-repo commit -m 'Initial commit'

# Clone it.
git -c filter.arrow-example.process="$(realpath arrow) process" clone "file://$(realpath remote-repo)" local-clone
